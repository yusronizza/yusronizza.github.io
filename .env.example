# Base URL used for canonical links, sitemap.xml, robots.txt and Open Graph tags.
# Set this to your production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://yusronizza.com

# Go backend base URL (no trailing slash). Defaults to http://localhost:8080.
API_URL=http://localhost:8080

# Client key issued by the Go backend for this frontend application.
# Required since API v1.11.0 — all public GET endpoints (posts, projects, profile, sitemap)
# now require either an admin Bearer token or a registered client key.
# Register via: POST /api/v1/admin/clients  { "name": "yusronizza-frontend" }
# The plaintext key is returned once at creation and never again.
API_CLIENT_KEY=
